<%- layout("layouts/boilerplate.ejs") %>
    
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .filter {
            text-align: center;
            margin-right: 2rem;
            opacity: 0.7;
        }

        .filter:hover{
            opacity: 1;
            cursor : pointer ;
        }


        .tax-toggle {
            margin-left: auto;
            border: 1px solid #ccc;
            padding: 0.5rem 1rem 0.5rem 1rem;
            border-radius: 25px;
            display: flex;
                align-items: center;
        }

        .tax-toggle:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }

        .form-switch  {
            margin:auto;
            padding: auto;
        }


                .filter i {
            font-size: 1.3rem;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .card img {
            object-fit: cover;
        }

       
    </style>
 
    <div id="filters">
        <div class="filter">
            <div> <i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div> <i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
        <div class="filter">
            <div> <i class="fa-solid fa-igloo"></i></div>
                <p>Igloos</p>
            </div>
    

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" role="switch">
                <label class="form-check-label" for="flexSwitchCheckDefault">Display total after tax</label>
            </div>
        </div>
    </div>
   <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-2">
        <% for (let listing of listings) { %>
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
        <div class="col mb-4" >
            <div class="card h-100">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height: 14rem;">
                <div class="card-img-overlay">
                    <h5 class="card-title"></h5>
                    <p class="card-text"></p>
                    <p class="card-text"><small></small></p>
                </div>
                <div class="card-body">
                     <p class="card-text listing-price" data-price="<%= listing.price %>">
                        <b><%= listing.title %></b><br>
                        ₹<%= listing.price.toLocaleString("en-IN") %> / night
                    </p>
                </div>
            </div>
        </div>
        </a>
        <% } %>
   </div>
    
<script>
        let taxSwitch = document.getElementById("flexSwitchCheckDefault");

    taxSwitch.addEventListener("change", function () {

        let priceElements = document.querySelectorAll(".listing-price");

        priceElements.forEach(function (element) {

            let basePrice = parseInt(element.dataset.price);

            if (taxSwitch.checked) {

                let totalPrice = Math.round(basePrice * 1.18);

                element.innerHTML =
                    `<b>${element.querySelector("b").innerText}</b><br>
                    ₹${totalPrice.toLocaleString("en-IN")} / night (incl. tax)`;

            } else {

                element.innerHTML =
                    `<b>${element.querySelector("b").innerText}</b><br>
                    ₹${basePrice.toLocaleString("en-IN")} / night`;
            }
        });
    });
</script>
