<% layout("/layouts/boilerplate") %>

<!-- HERO SECTION -->

<div class="hero d-flex align-items-center justify-content-center text-center">

    <div class="hero-content text-white">
        <h1 class="display-4 fw-bold">Find your next stay</h1>

        <p class="lead">
            Discover unique places to stay around the world
        </p>

        <form action="/listings" method="GET" class="d-flex justify-content-center mt-3">

            <input
            type="text"
            name="search"
            class="form-control w-50 me-2"
            placeholder="Search destination">

            <button class="btn btn-danger">
                Search
            </button>

        </form>
    </div>

</div>


<!-- CATEGORIES -->

<div class="container mt-5">

<h3 class="text-center mb-4">Explore Categories</h3>

<div class="row text-center">

<div class="col-md-3">
<div class="category-box">
🏖️
<p>Beach</p>
</div>
</div>

<div class="col-md-3">
<div class="category-box">
🏕️
<p>Camping</p>
</div>
</div>

<div class="col-md-3">
<div class="category-box">
🏔️
<p>Mountain</p>
</div>
</div>

<div class="col-md-3">
<div class="category-box">
🏡
<p>Cabins</p>
</div>
</div>

</div>

</div>


<!-- CTA SECTION -->

<div class="container text-center mt-5">

<h2>Become a Host</h2>

<p>Earn money by sharing your space.</p>

<a href="/listings/new" class="btn btn-dark">
Start Hosting
</a>

</div>